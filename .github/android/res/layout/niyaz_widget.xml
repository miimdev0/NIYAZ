<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/niyaz_widget_bg"
    android:orientation="vertical"
    android:padding="12dp"
    android:layoutDirection="rtl">
    <!-- نیاز · چیدمان ویجت صفحهٔ اصلی · © Mojtaba Meidani -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_logo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/niyaz_name"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_j"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/niyaz_name"
                android:textColor="#FFF4C25B"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_h"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#FFDCE9FA"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/w_g"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#FF9FB4D8"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/w_occ"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="2"
        android:textColor="#FF5FD3D0"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_pn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:textColor="#FFE8EEFC"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_pt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFF4C25B"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_loc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="#FF7C90B4"
        android:textSize="10sp" />
</LinearLayout>
